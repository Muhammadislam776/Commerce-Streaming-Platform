// Project Supernova: Next-Generation Live Commerce Database Schema
// High-performance PostgreSQL with pgvector extension for RAG search

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector")]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum LiveEventStatus {
  SCHEDULED
  LIVE
  PAUSED
  ENDED
  ARCHIVED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAYMENT_CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

enum WebhookStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum ReservationStatus {
  ACTIVE
  CONVERTED
  EXPIRED
  CANCELLED
}

// -------------------------------------------------------------
// 1. LIVE EVENT & STREAMING INFRASTRUCTURE
// -------------------------------------------------------------
model LiveEvent {
  id                  String          @id @default(uuid())
  slug                String          @unique
  title               String
  description         String?
  bannerUrl           String?
  status              LiveEventStatus @default(SCHEDULED)
  hostUserId          String
  
  // Media & Edge Topology
  sfuRoomName         String          @unique
  rtmpIngestKey       String          @unique
  llHlsPlaybackUrl    String?
  webrtcFallbackThreshold Int        @default(5000) // Switch to LL-HLS past 5k interactive viewers

  // Telemetry & Metrics
  scheduledStartTime  DateTime
  actualStartTime     DateTime?
  actualEndTime       DateTime?
  peakViewerCount     Int             @default(0)
  totalUniqueViewers  Int             @default(0)
  totalGrossRevenue   Decimal         @default(0.00) @db.Decimal(12, 2)

  // Relations
  pinnedProducts      EventProductPin[]
  chatMessages        LiveChatMessage[]
  orders              Order[]
  summaries           EventSummary?
  
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status, scheduledStartTime])
  @@index([hostUserId])
}

// -------------------------------------------------------------
// 2. PRODUCT CATALOG & REAL-TIME INVENTORY
// -------------------------------------------------------------
model Product {
  id                  String             @id @default(uuid())
  sku                 String             @unique
  title               String
  description         String
  brand               String
  category            String
  basePrice           Decimal            @db.Decimal(10, 2)
  liveDiscountPrice   Decimal?           @db.Decimal(10, 2)
  currency            String             @default("USD")
  
  // Real-time stock counters (Primary source of truth synced with Redis)
  totalStock          Int
  reservedStock       Int                @default(0)
  
  // Rich specs for Multilingual RAG
  specifications      Json               // Key-value attributes (material, dimensions, care)
  mediaUrls           String[]
  isActive            Boolean            @default(true)
  
  // Relations
  pinnedInEvents      EventProductPin[]
  reservations        InventoryReservation[]
  orderItems          OrderItem[]
  embeddings          CatalogEmbedding[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([sku])
  @@index([isActive, category])
}

// Real-time Product Pins pushed by Host during Live Stream
model EventProductPin {
  id                  String          @id @default(uuid())
  liveEventId         String
  productId           String
  isCurrentlyPinned   Boolean         @default(true)
  pinOrder            Int             @default(1)
  pinnedAt            DateTime        @default(now())
  unpinnedAt          DateTime?
  
  // Real-time conversion telemetry
  impressions         Int             @default(0)
  clicks              Int             @default(0)
  cartAdditions       Int             @default(0)
  purchases           Int             @default(0)

  liveEvent           LiveEvent       @relation(fields: [liveEventId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([liveEventId, isCurrentlyPinned])
  @@index([productId])
}

// Redis-backed Flash Sale Inventory Locks
model InventoryReservation {
  id                  String            @id @default(uuid())
  cartId              String
  userId              String?
  productId           String
  quantity            Int
  status              ReservationStatus @default(ACTIVE)
  expiresAt           DateTime
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  product             Product           @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([cartId, status])
  @@index([expiresAt, status])
}

// -------------------------------------------------------------
// 3. MULTILINGUAL CATALOG RAG & VECTOR EMBEDDINGS (pgvector)
// -------------------------------------------------------------
model CatalogEmbedding {
  id                  String                      @id @default(uuid())
  productId           String
  locale              String                      @default("en") // en, es, fr, ar, ur, zh, ja, etc.
  chunkType           String                      // "specs", "qa", "usage", "pricing"
  chunkText           String                      @db.Text
  
  // 1536-dimensional vector embedding (e.g. OpenAI text-embedding-3-small or Gemini text-embedding-004)
  embedding           Unsupported("vector(1536)")
  
  metadata            Json?                       // Token count, source fields, version

  product             Product                     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt           DateTime                    @default(now())

  @@index([productId, locale])
}

// -------------------------------------------------------------
// 4. CHECKOUT, ORDERS & IDEMPOTENT WEBHOOKS
// -------------------------------------------------------------
model Order {
  id                  String          @id @default(uuid())
  orderNumber         String          @unique
  userId              String
  liveEventId         String?
  
  totalAmount         Decimal         @db.Decimal(10, 2)
  currency            String          @default("USD")
  status              OrderStatus     @default(PENDING_PAYMENT)
  
  // Idempotency & Payment gateway links
  idempotencyKey      String          @unique
  paymentGateway      String          @default("stripe")
  paymentIntentId     String?         @unique
  
  shippingAddress     Json
  billingAddress      Json
  
  items               OrderItem[]
  liveEvent           LiveEvent?      @relation(fields: [liveEventId], references: [id], onDelete: SetNull)

  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId, status])
  @@index([liveEventId])
  @@index([idempotencyKey])
}

model OrderItem {
  id                  String          @id @default(uuid())
  orderId             String
  productId           String
  quantity            Int
  unitPrice           Decimal         @db.Decimal(10, 2)
  discountApplied     Decimal         @default(0.00) @db.Decimal(10, 2)

  order               Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product             Product         @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

// Strictly Idempotent Webhook Processing Log
model WebhookEvent {
  id                  String          @id @default(uuid())
  provider            String          // e.g., "stripe", "adyen", "shopify"
  eventId             String          @unique // Unique ID issued by provider
  eventType           String          // e.g., "payment_intent.succeeded"
  
  idempotencyKey      String          @unique
  signatureHeader     String
  payloadHash         String          // SHA256 of raw string body
  rawPayload          Json
  
  status              WebhookStatus   @default(RECEIVED)
  retryCount          Int             @default(0)
  errorMessage        String?
  
  processedAt         DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([status, retryCount])
  @@index([provider, eventType])
}

// -------------------------------------------------------------
// 5. REAL-TIME CHAT & AI MODERATION
// -------------------------------------------------------------
model LiveChatMessage {
  id                  String          @id @default(uuid())
  liveEventId         String
  userId              String
  userName            String
  userAvatar          String?
  content             String          @db.VarChar(500)
  
  isHost              Boolean         @default(false)
  isModerator         Boolean         @default(false)
  isPinned            Boolean         @default(false)
  
  // Real-time AI Safety telemetry
  toxicityScore       Float           @default(0.0)
  isFlagged           Boolean         @default(false)
  flagReason          String?
  
  liveEvent           LiveEvent       @relation(fields: [liveEventId], references: [id], onDelete: Cascade)
  createdAt           DateTime        @default(now())

  @@index([liveEventId, createdAt])
  @@index([isFlagged])
}

// -------------------------------------------------------------
// 6. POST-EVENT AI SUMMARIES & TRANSCRIPTS
// -------------------------------------------------------------
model EventSummary {
  id                  String          @id @default(uuid())
  liveEventId         String          @unique
  transcriptText      String          @db.Text
  executiveRecap      String          @db.Text
  
  // Structured Timestamps & Conversion Highlights
  productTimestamps   Json            // Array of [{ productId, timestampSec, hostHighlights }]
  keyMoments          Json            // Array of [{ timestampSec, label, viewerSpike }]
  salesAnalytics      Json            // Conversion rate, peak velocity, revenue breakdown
  
  liveEvent           LiveEvent       @relation(fields: [liveEventId], references: [id], onDelete: Cascade)
  createdAt           DateTime        @default(now())
}
